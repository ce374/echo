# Built application files
*.apk
*.ap_
*.aab

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
.cxx/

# Gradle files
.gradle/
build/
SaidIt/build/

# Local configuration file (sdk path, signing config, etc)
local.properties

# Signing / secrets
*.jks
*.keystore
keystore.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# IDEs
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Backups
*.orig
*.bak
*~

# Allow CI-published APKs in public/
!public/
!public/*.apk
